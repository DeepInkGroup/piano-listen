    "preview": "vite preview --host 127.0.0.1 --configLoader native"
  },
  "dependencies": {
    "vexflow": "4.2.5"
  },
  "devDependencies": {
    "vite": "6.4.3",
    "@playwright/test": "1.63.0"
  }
}
